# ==========================================
# FarmerAssist Monorepo Git Ignore
# ==========================================

# 1. Flutter Build & Cache Artifacts
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.pub-cache/
**/.pub/

# 2. Java & Maven Artifacts
**/target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# 3. Android Keystore & Secret Credentials (SECURITY)
*.jks
*.keystore
key.properties
*.env
*.env.*
*.secret

# 4. IDE & Editor Specific
.idea/
.vscode/
*.iml
*.ipr
*.iws
.DS_Store
Thumbs.db
*.swp

# 5. Logs & Temporary Files
*.log
*.tmp
.history
.agents/
.sf/
